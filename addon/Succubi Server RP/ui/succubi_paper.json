              "binding_name": "#title_text"
            }
          ],
          "font_type": "smooth"
        }
      },
      {
        "body": {
          "type": "label",
          "text": "#form_text",
          "color": [
            0.2,
            0.12,
            0.06
          ],
          "localize": false,
          "shadow": false,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [
            20,
            30
          ],
          "size": [
            260,
            "default"
          ],
          "layer": 5,
          "bindings": [
            {
              "binding_name": "#form_text"
            }
          ],
          "font_type": "smooth"
        }
      },
      {
        "slots": {
          "type": "grid",
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [
            -14,
            -12
          ],
          "size": [
            142,
            30
          ],
          "grid_dimensions": [
            2,
            1
          ],
          "grid_item_template": "succubi_paper.cell",
          "collection_name": "form_buttons",
          "layer": 5
        }
      }
    ]
  }
}
