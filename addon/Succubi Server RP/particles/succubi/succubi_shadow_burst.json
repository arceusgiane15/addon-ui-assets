{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "succubi:shadow_burst",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/succubi/shadow_smoke"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 70
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          1,
          0
        ],
        "radius": 0.5,
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.8 + variable.particle_random_1 * 0.7"
      },
      "minecraft:particle_initial_speed": "2 + variable.particle_random_2 * 2",
      "minecraft:particle_initial_spin": {
        "rotation": "variable.particle_random_4 * 360",
        "rotation_rate": 90
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.6,
          0
        ],
        "linear_drag_coefficient": 3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.3 - variable.particle_age * 0.15",
          "0.3 - variable.particle_age * 0.15"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              16,
              16
            ],
            "step_UV": [
              0,
              16
            ],
            "max_frame": 8,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.05 + variable.particle_random_2 * 0.05",
          "0.02",
          "0.07 + variable.particle_random_2 * 0.06",
          "1 - math.pow(variable.particle_age / variable.particle_lifetime, 2) * 0.92"
        ]
      }
    }
  }
}
